# Wankarr example config — copy to .env and fill in your values.
# .env is git-ignored and must never be committed (it holds secrets).
#
# Feeds are generic: list any number of private-tracker RSS notification
# feeds (their URLs carry their own auth) and any number of Jackett
# Torznab indexer paths. No site is named here.

# XBVR instance to read library + wishlist from
XBVR_URL=http://127.0.0.1:9999

# Tracker RSS notification feed(s), comma-separated if more than one.
# Paste the full private feed URL(s) from each tracker's notification page.
RSS_FEEDS=

# Jackett server + API key (from the Jackett dashboard, top-right)
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=

# Torznab indexer path(s), comma-separated if more than one.
# Per indexer: Jackett dashboard -> indexer -> Torznab feed.
JACKETT_TORZNAB_PATHS=/api/v2.0/indexers/empornium/results/torznab/

# Transmission RPC endpoint
TRANSMISSION_URL=http://127.0.0.1:9091/transmission/rpc
# Leave empty if Transmission has no auth configured
TRANSMISSION_USER=
TRANSMISSION_PASS=
# Optional: override Transmission's default download directory.
# Empty = use the server default. Must exist and be writable by Transmission.
# Example: TRANSMISSION_DOWNLOAD_DIR=/mnt/media/vr
TRANSMISSION_DOWNLOAD_DIR=

# Optional tuning (defaults shown)
# HTTP_PORT=8060
# DB_PATH=wankarr.db
# POLL_INTERVAL=4h
