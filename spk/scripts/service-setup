#!/bin/sh
# Wankarr service definition (follows spksrc generic service conventions).

WANKARR="${SYNOPKG_PKGDEST}/bin/wankarr"
SERVICE_COMMAND="${WANKARR}"
SVC_BACKGROUND=y
SVC_WRITE_PID=y
PID_FILE="${SYNOPKG_PKGVAR}/wankarr.pid"
LOG_FILE="${SYNOPKG_PKGVAR}/wankarr.log"

# Run with the var dir as cwd: .env and wankarr.db live there.
SVC_CWD="${SYNOPKG_PKGVAR}"

dotenv_quote()
{
    # Quote $1 for the .env file: single quotes, newlines stripped
    # (wizard fields are single-line), embedded quotes escaped.
    clean=$(printf '%s' "$1" | tr -d '\r\n')
    if [ -z "$clean" ]; then
        # sed prints nothing for empty input (no lines in), so quote
        # the empty case explicitly to keep every value quoted.
        printf "''"
    else
        printf '%s' "$clean" | sed -e "s/'/'\\\\''/g" -e "s/^/'/" -e "s/$/'/"
    fi
}

write_dotenv()
{
    # Write ${SYNOPKG_PKGVAR}/.env from wizard_* answers (install or
    # upgrade wizard pre-fills every box, so a full rewrite is safe).
    {
        echo "# Generated by the Wankarr install wizard."
        echo "# Edit with care: RSS and API values are secrets."
        printf 'XBVR_URL=%s\n' "$(dotenv_quote "${wizard_xbvr_url:-http://127.0.0.1:9999}")"
        printf 'RSS_FEEDS=%s\n' "$(dotenv_quote "${wizard_rss_feeds:-}")"
        printf 'JACKETT_URL=%s\n' "$(dotenv_quote "${wizard_jackett_url:-http://127.0.0.1:9117}")"
        printf 'JACKETT_API_KEY=%s\n' "$(dotenv_quote "${wizard_jackett_api_key:-}")"
        printf 'JACKETT_TORZNAB_PATHS=%s\n' "$(dotenv_quote "${wizard_torznab_paths:-/api/v2.0/indexers/empornium/results/torznab/}")"
        printf 'TRANSMISSION_URL=%s\n' "$(dotenv_quote "${wizard_transmission_url:-http://127.0.0.1:9091/transmission/rpc}")"
        printf 'TRANSMISSION_USER=%s\n' "$(dotenv_quote "${wizard_transmission_user:-}")"
        printf 'TRANSMISSION_PASS=%s\n' "$(dotenv_quote "${wizard_transmission_pass:-}")"
        printf 'TRANSMISSION_DOWNLOAD_DIR=%s\n' "$(dotenv_quote "${wizard_transmission_dir:-}")"
    } > "${SYNOPKG_PKGVAR}/.env"
    chmod 600 "${SYNOPKG_PKGVAR}/.env"
}

service_postinst()
{
    # Fresh install only: never overwrite an existing .env (it holds
    # the user's tracker credentials).
    if [ -f "${SYNOPKG_PKGVAR}/.env" ]; then
        return 0
    fi
    write_dotenv
}

service_postupgrade()
{
    # With the DSM wizards parked (see mkspk), upgrades arrive with no
    # wizard answers: keep an existing .env, but never leave the package
    # without one — seed defaults the user then edits by hand.
    if [ ! -f "${SYNOPKG_PKGVAR}/.env" ]; then
        write_dotenv
        return 0
    fi
    if [ -z "${wizard_xbvr_url:-}" ] && [ -z "${wizard_rss_feeds:-}" ]; then
        return 0
    fi
    write_dotenv
}

service_prestart()
{
    # Ensure the var dir exists for .env, wankarr.db, pid and log files.
    mkdir -p "${SYNOPKG_PKGVAR}"
}
